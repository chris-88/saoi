{
  "name": "saoi",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:guardrails": "node --env-file=.env evals/guardrails/run.ts",
    "seed:generate": "node scripts/generate-seed.ts",
    "seed:check": "node scripts/generate-seed.ts check",
    "market:refresh": "node scripts/market/refresh.ts",
    "plan:sample": "node scripts/plan-handoff/save-sample.ts",
    "compare:models": "node --env-file=.env scripts/compare-models.ts",
    "db:types": "supabase gen types typescript --linked > supabase/functions/_shared/db/database.types.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run seed:check && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "description": "Saoi backend: saoi-api, the schema and the shared domain for a conversational banking demo over a fictional Demo Bank",
  "engines": {
    "node": ">=24"
  }
}
