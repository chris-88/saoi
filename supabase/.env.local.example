# saoi-api environment for local development (copy to services/api/.env).
# Never commit the real file. docs/dev/environment-variables.md explains every entry.

# ---- Required. Every one of these throws on startup if unset. ----

# Anthropic. The only model provider; called from saoi-api only, never the browser.
ANTHROPIC_API_KEY=
SAOI_MODEL=claude-sonnet-5-5
GATE_MODEL=claude-haiku-4-5-20251001

# Where the app is served. Used to build the links inside push notifications and the
# data-notice card, so it has to match the origin you are actually browsing.
APP_BASE_URL=http://127.0.0.1:5173

# Web Push (RFC 8291/8292), hand-written in _shared/push and sent by the admin routes.
# Generate a key pair with `npx web-push generate-vapid-keys`; VAPID_PRIVATE_D is the
# private key's `d` value.
# VAPID_PUBLIC_KEY must match VITE_VAPID_PUBLIC_KEY in the app's .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_D=
VAPID_SUBJECT=mailto:you@example.com

# ---- Optional. Unset is a valid configuration; these are read from the environment directly. ----

# Audience cases allowed in a rolling 24 hours (§47). Defaults applied in the function.
AUDIENCE_MAX_CASES=50

# Unlocks the all-conversations switcher on whichever device holds it. Leave unset and
# nobody can open it (§45).
PRESENTER_KEY=

# `fixture` replays a script from services/api/src/turn/fixtures/ instead of calling
# Anthropic, so a conversation runs with no key and no bill. LLM_FIXTURE names the script.
# Leave both unset for the real model.
LLM_PROVIDER=
LLM_FIXTURE=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform both locally and
# when deployed. Do not set them here.
