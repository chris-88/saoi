# saoi-api. Real values come from `pass show env/saoi/...` or the stack's env, never this file.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
PORT=3000
# The conversation turn. LLM_PROVIDER=fixture replays a script and needs no key.
LLM_PROVIDER=fixture
LLM_FIXTURE=opening
ANTHROPIC_API_KEY=
SAOI_MODEL=claude-sonnet-5-5
GATE_MODEL=claude-haiku-4-5-20251001
APP_BASE_URL=http://localhost:5173/
TURN_TIMEOUT_MS=85000
TURN_MAX_OUTPUT_TOKENS=3072
# POST /api/internal/alerts/run: the key the alerts timer sends as X-Internal-Key (16+ characters).
# Unset, the route answers 404.
INTERNAL_JOB_KEY=
